# Development server approach - most reliable
FROM node:18-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm install

# Copy source code
COPY . .

# Set environment variables
ENV VITE_API_BASE_URL=http://104.248.180.230:8000/api/v1
ENV VITE_EMAILJS_SERVICE_ID=service_dotbrub
ENV VITE_EMAILJS_TEMPLATE_ID=template_2xxcsrq
ENV VITE_EMAILJS_PUBLIC_KEY=M8ZdPyX2WzkQORfB8

# Expose port
EXPOSE 5173

# Start development server
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
